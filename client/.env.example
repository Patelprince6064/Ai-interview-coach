# Google OAuth Client ID (get from console.cloud.google.com)
# Must match the GOOGLE_CLIENT_ID in server/.env
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Anthropic API Key — used for guest-mode scoring (no backend)
# WARNING: Only use a restricted key here; do NOT expose a full-access key in the browser
# For production, remove this and rely on server-side scoring only
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
